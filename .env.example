# ERPNext Configuration
ERP_BASE_URL=https://your-erpnext.example.com
ERP_API_KEY=your_api_key_here
ERP_API_SECRET=your_api_secret_here

# Shopify Configuration
SHOPIFY_STORE=my-shop.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# OpenAI / ChatGPT Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Behavior Configuration
IMAGE_DIR=./data/images
PAGE_SIZE=100
RATE_LIMIT_RPS=1.5
DRY_RUN=false
APPROVAL_MODE=manual
LOG_LEVEL=INFO
LOG_FILE=./logs/uploader.log

# Database
DB_PATH=./data/state.db

# Scraping
USER_AGENT=Mozilla/5.0 (compatible; ProductUploader/1.0)
SCRAPE_TIMEOUT=30
MAX_RETRIES=3